# macOS
.DS_Store

# Python cache / environments
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Local runtime settings and generated payroll output
settings.json
Gesob_Lohn/

# Local backups created during UI experiments
backups/

# Logs and temporary files
*.log
*.tmp
*.bak

# Build outputs and signing material
**/build/
**/dist/
**/release/
*.pfx
*.p12
*.cer
secrets/
.env
.env.*
!.env.example

# Runtime data must never be packaged or committed
**/Settings/
**/Companies/
**/license.json
**/machine_id
**/secrets.dat
**/workflow_sessions.json
**/*.sqlite3
**/*.sqlite3-wal
**/*.sqlite3-shm

# License server is maintained as a separate repository
license-server/

# JavaScript package manager cache
.npm/
node_modules/
.next/
out/
.vercel/

# Separate clean checkout used for website publishing
LohnMail_web_publish/
